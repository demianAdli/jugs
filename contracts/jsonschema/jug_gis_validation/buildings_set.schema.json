{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/jsonschema/jug_gis_validation/buildings_set.schema.json",
  "title": "JUG GIS Validation Buildings Set GeoJSON",
  "description": "GeoJSON FeatureCollection payload accepted by POST /validations and POST /validations/upload. It follows the building GeoJSON pattern used by jug_lca_buildings and adds validation-specific fields.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "id": {
          "type": ["integer", "string"],
          "description": "GeoJSON feature id for the building."
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "properties": {
          "$ref": "#/$defs/buildingProperties"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon", "MultiPolygon"]
        },
        "coordinates": {
          "type": "array",
          "description": "GeoJSON polygon or multipolygon coordinates."
        }
      }
    },
    "buildingProperties": {
      "type": "object",
      "required": [
        "name",
        "function",
        "year_of_construction",
        "fsa"
      ],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "function": { "type": ["string", "integer"] },
        "height": { "type": "number" },
        "year_of_construction": { "type": ["integer", "string"] },
        "fsa": {
          "type": "string",
          "description": "Forward sortation area or postal-code prefix used as the validation district code."
        },
        "area": {
          "type": "number",
          "description": "Feature area, interpreted according to area_calculation_mode."
        },
        "floor_num": {
          "type": ["integer", "number"],
          "description": "Number of floors required by the area-times-floor calculation mode."
        },
        "unit_num": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Example per-feature unit count selectable through cleaned_units_num_key. NULL contributes one unit."
        }
      }
    }
  }
}
