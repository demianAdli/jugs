{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/jsonschema/jug_gis_cities/standardized_building_geojson.schema.json",
  "title": "JUG GIS Cities Standardized Building GeoJSON",
  "description": "Strict standardized GeoJSON output produced by standardize mode after contract adaptation. Raw source fields are removed and required null-field features are dropped by the adapter.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "id": {
          "type": "integer",
          "description": "Promoted GeoJSON feature id generated by the contract adapter."
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "properties": {
          "$ref": "#/$defs/buildingProperties"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon", "MultiPolygon"]
        },
        "coordinates": {
          "type": "array"
        }
      }
    },
    "buildingProperties": {
      "type": "object",
      "required": [
        "name",
        "height",
        "function",
        "address",
        "year_of_construction"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "height": { "type": "number" },
        "function": { "type": "string" },
        "address": { "type": "string" },
        "year_of_construction": {
          "type": ["integer", "string"],
          "description": "Year of construction as preserved or normalized by the component adapter."
        }
      }
    }
  }
}
