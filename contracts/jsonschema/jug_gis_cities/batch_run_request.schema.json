{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/jsonschema/jug_gis_cities/batch_run_request.schema.json",
  "title": "JUG GIS Cities FSA Batch Run Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["independent", "standardize"],
      "default": "standardize"
    },
    "fsas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][0-9][A-Za-z]$"
      }
    },
    "all_fsas": {"type": "boolean", "default": false},
    "max_workers": {"type": "integer", "minimum": 1, "default": 1},
    "drop_null_fields": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1}
    },
    "cleanup_outputs": {"type": "boolean", "default": false},
    "keep_outputs": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1}
    }
  },
  "oneOf": [
    {
      "required": ["fsas"],
      "properties": {"all_fsas": {"const": false}}
    },
    {
      "required": ["all_fsas"],
      "properties": {"all_fsas": {"const": true}},
      "not": {"required": ["fsas"]}
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["keep_outputs"],
        "properties": {
          "keep_outputs": {"type": "array", "minItems": 1}
        }
      },
      "then": {
        "required": ["cleanup_outputs"],
        "properties": {"cleanup_outputs": {"const": true}}
      }
    }
  ]
}
